# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files / secrets — never commit API keys
.env
.env.*
.env*.local
!.env.example

# local PDF samples for ingestion testing (not committed)
/samples/

# regenerable corpus (pages/chunks) — large, rebuild with pipeline:corpus
/data/corpus/

# pipeline append-only log (progress.json + STATUS.md are committed)
/data/pipeline/run-log.jsonl

# generated machine-readable API (rebuilt by npm run export:data / prebuild)
/public/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
