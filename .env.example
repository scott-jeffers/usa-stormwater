# LLM mode for pipeline:
#   heuristic (default when no key) — offline TOC/tagging, no API
#   cursor — Cursor SDK (requires CURSOR_API_KEY)
PIPELINE_LLM=heuristic

# Cursor SDK — only needed when PIPELINE_LLM=cursor
# Create at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Model id (local runtime). Default: composer-2.5-fast (lightest)
PIPELINE_MODEL=composer-2.5-fast

# Delay between AI jobs (ms) to ease rate limits
PIPELINE_DELAY_MS=2000
