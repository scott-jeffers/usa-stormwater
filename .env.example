# LLM mode for pipeline:
#   heuristic — offline TOC/tagging / enrich
#   cursor — Cursor SDK (npm run pipeline:cursor-login first)
# overnight:go and overnight:enrich force cursor unless you pass --heuristic
PIPELINE_LLM=heuristic

PIPELINE_MODEL=composer-2.5
PIPELINE_DELAY_MS=2000

# Overnight (Cursor, same plan usage as the IDE — not a separate API invoice):
#   npm run pipeline:cursor-login   # once, browser
#   npm run overnight:go            # then sleep; status → data/pipeline/GO.md
# Offline fallback:
#   npx tsx scripts/pipeline/overnight-go.ts --heuristic
#
# Enrich-only (bioretention + permeable pavement):
#   npm run overnight:enrich
