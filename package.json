    "postbuild": "pagefind --site out --output-subdir pagefind",
    "manual:pdf": "tsx scripts/manual-pdf.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "export:data": "tsx scripts/export-data.ts && tsx scripts/export-research.ts",
    "prebuild": "npm run export:data",
    "perf:smoke": "tsx scripts/perf/smoke-nav.ts",
    "prepare:queue": "tsx scripts/prepare.ts",
    "save": "tsx scripts/save.ts",
    "overnight": "tsx scripts/prepare.ts",
    "overnight:enrich": "tsx scripts/pipeline/overnight-enrich.ts",
    "overnight:go": "tsx scripts/pipeline/overnight-go.ts",
    "ingest": "tsx scripts/ingest.ts",
    "coverage:fetch-targets": "tsx scripts/fetch-coverage-targets.ts",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "agency:report": "tsx scripts/agency-coverage-report.ts",
    "agency:discover": "tsx scripts/agency-discover.ts",
    "agency:seed-registry": "tsx scripts/seed-agency-registry.ts",
    "agency:backfill": "tsx scripts/backfill-agency-category.ts",
    "pipeline:run": "tsx scripts/pipeline/run.ts",
    "pipeline:status": "tsx scripts/pipeline/status.ts",
    "pipeline:verify-report": "tsx scripts/pipeline/verify-report.ts",
    "qa:evidence": "tsx scripts/qa/check-evidence.ts",
    "qa:normalize": "tsx scripts/qa/normalize-documents.ts",
    "qa:apply-review": "tsx scripts/qa/apply-value-review.ts",
    "qa:storms": "tsx scripts/qa/design-storm-purposes.ts",
    "archive:build": "tsx scripts/archive/build-archive.ts",
    "qa:alt-text": "tsx scripts/qa/build-alt-text.ts",
    "qa:repair": "tsx scripts/qa/repair-evidence.ts",
    "qa:find-quotes": "tsx scripts/qa/find-quotes.ts",
    "qa": "npm run -s qa:alt-text && npm run -s qa:evidence && npm run -s qa:repair -- --dry-run && npm run -s qa:find-quotes -- --dry-run && npm run -s coverage:report",
    "qa:freshness": "tsx scripts/qa/check-freshness.ts",
    "pipeline:repair-excerpts": "tsx scripts/pipeline/repair-excerpts.ts",
    "pipeline:corpus": "tsx scripts/pipeline/run.ts --stage corpus",
    "pipeline:extract": "tsx scripts/pipeline/run.ts --stage extract",
    "pipeline:verify": "tsx scripts/pipeline/run.ts --stage verify",
    "pipeline:outline": "tsx scripts/pipeline/run.ts --stage outline",
    "pipeline:draft": "tsx scripts/pipeline/run.ts --stage draft",
    "pipeline:enrich-parameters": "tsx scripts/pipeline/enrich-parameters.ts",
    "pipeline:cursor-login": "tsx scripts/pipeline/cursor-login.ts",
    "national:practice-matrix": "tsx scripts/national/build-practice-matrix.ts",
    "national:synthesize-practice": "tsx scripts/national/synthesize-practice.ts",
    "national:tier-a": "tsx scripts/national/build-tier-a.ts --write",
    "national:repair-tier-a": "tsx scripts/national/repair-tier-a.ts",
    "national:editorial": "tsx scripts/national/apply-editorial.ts",
    "national:guidance-tables": "tsx scripts/national/build-guidance-tables.ts",
    "national:recommendation-clauses": "tsx scripts/national/build-recommendation-clauses.ts",
    "national:curate-citations": "tsx scripts/national/curate-citations.ts",
    "national:rewrite-voice": "tsx scripts/national/rewrite-voice.ts",
    "national:spotcheck-heroes": "tsx scripts/national/spotcheck-heroes.ts",
    "national:refresh-core": "tsx scripts/national/refresh-core-parents.ts",
    "national:classify": "tsx scripts/national/classify-criteria.ts && tsx scripts/national/classify-criteria.ts --part=esc && tsx scripts/national/classify-criteria.ts --part=det && tsx scripts/national/classify-criteria.ts --part=conv && tsx scripts/national/classify-criteria.ts --part=hyd && tsx scripts/national/classify-criteria.ts --part=sd && tsx scripts/national/classify-criteria.ts --part=pt && tsx scripts/national/classify-criteria.ts --part=fp",
    "national:smoke": "tsx scripts/national/smoke-check.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.4.1",
    "d3-geo": "3.1.2",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-simple-maps": "3.0.0",
    "unpdf": "1.9.1",
    "us-atlas": "^3.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "d3-color": "3.1.0",
