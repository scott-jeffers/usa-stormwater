    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-simple-maps": "3.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
